APP_ENV=development
DATABASE_URL="postgresql://prumo:prumo@localhost:5432/prumo?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
QUEUE_ENABLED=true
QUEUE_MAX_ATTEMPTS=5

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Prumo <nao-responda@prumo.local>"
EMAIL_TIMEOUT_MS=10000
APP_WEB_URL="http://localhost:3000"
ALLOW_COMMUNICATION_TEST_ENDPOINTS=false
EXPO_ACCESS_TOKEN=

API_PORT=3333
SWAGGER_ENABLED=true
SWAGGER_RESTRICTED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
JWT_ACCESS_SECRET="altere-esta-chave-access"
JWT_REFRESH_SECRET="altere-esta-chave-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_PLATFORM_ACCESS_EXPIRES_IN="5m"
JWT_PLATFORM_REFRESH_EXPIRES_IN="8h"
BCRYPT_ROUNDS=12
CORS_ORIGINS="http://localhost:3000"
# Storage S3 privado (MinIO local; use S3/R2 equivalente em staging).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="prumo-documents"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID="prumo"
STORAGE_SECRET_ACCESS_KEY="prumo-development-only"
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_SERVER_SIDE_ENCRYPTION=none
STORAGE_KMS_KEY_ID=

# Protege /metrics; obrigatório em staging/produção.
METRICS_TOKEN=

# Exclusivamente para o seed de demonstração local.
SEED_ADMIN_PASSWORD="PrumoDev@123"

# Uso único pelo comando db:bootstrap-admin. Não mantenha a senha no arquivo.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

NEXT_PUBLIC_API_URL="http://localhost:3333/api"
API_URL="http://localhost:3333/api"

# Troque pelo IP local do computador ao testar em celular físico.
EXPO_PUBLIC_API_URL="http://192.168.0.10:3333/api"
