model Tenant {
  id                       String                           @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String                           @unique
  document                 String?
  status                   TenantStatus                     @default(TRIAL)
  planCode                 String?
  trialStartsAt            DateTime?
  trialEndsAt              DateTime?
  activatedAt              DateTime?
  suspendedAt              DateTime?
  suspensionReason         String?
  cancelledAt              DateTime?
  cancellationReason       String?
  archivedAt               DateTime?
  createdByPlatformUserId  String?                          @db.Uuid
  provisioningKey          String?                          @unique
  createdByPlatformUser    User?                            @relation("TenantCreatedByPlatformUser", fields: [createdByPlatformUserId], references: [id], onDelete: SetNull)
  memberships              Membership[]
  refreshSessions          RefreshSession[]
  students                 Student[]
  instructors              Instructor[]
  vehicles                 Vehicle[]
  studentAddresses         StudentAddress[]
  studentDocuments         StudentDocument[]
  studentNotes             StudentNote[]
  studentProcesses         StudentProcess[]
  lessons                  Lesson[]
  schoolUnits              SchoolUnit[]
  classrooms               Classroom[]
  instructorAvailabilities InstructorAvailability[]
  scheduleBlocks           ScheduleBlock[]
  theoreticalClasses       TheoreticalClass[]
  theoreticalClassStudents TheoreticalClassStudent[]
  licenseProcesses         StudentLicenseProcess[]
  processCategories        StudentProcessCategory[]
  processStages            ProcessStage[]
  processStageDependencies ProcessStageDependency[]
  processDocuments         ProcessDocumentRequirement[]
  exams                    Exam[]
  auditLogs                AuditLog[]
  financialServices        Service[]
  servicePlans             ServicePlan[]
  servicePlanItems         ServicePlanItem[]
  studentContracts         StudentContract[]
  studentContractItems     StudentContractItem[]
  contractAdjustments      ContractAdjustment[]
  receivableInstallments   ReceivableInstallment[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  paymentRefunds           PaymentRefund[]
  cashRegisters            CashRegister[]
  cashMovements            CashMovement[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  financialSettings        TenantFinancialSettings?
  domainEvents             DomainEvent[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationDeliveries   NotificationDelivery[]
  devicePushTokens         DevicePushToken[]
  reminderRules            ReminderRule[]
  communicationCampaigns   CommunicationCampaign[]
  campaignRecipients       CommunicationCampaignRecipient[]
  scheduledTaskExecutions  ScheduledTaskExecution[]
  lessonChangeRequests     LessonChangeRequest[]
  lessonEvaluations        LessonEvaluation[]
  vehicleOccurrences       VehicleOccurrence[]
  mobileOperations         MobileOperation[]
  documentUploadSessions   DocumentUploadSession[]
  settings                 TenantSettings?
  subscriptions            TenantSubscription[]
  supportSessions          SupportSession[]
  credentialTokens         UserCredentialToken[]
  importJobs               ImportJob[]
  importFiles              ImportFile[]
  importMappings           ImportMapping[]
  legacyImportMaps         LegacyImportMap[]
  importIssues             ImportIssue[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([status, createdAt])
  @@index([planCode, status])
  @@index([trialEndsAt])
}

model User {
  id                        String                           @id @default(uuid()) @db.Uuid
  name                      String
  email                     String                           @unique
  passwordHash              String
  active                    Boolean                          @default(true)
  platformRole              PlatformRole                     @default(USER)
  mfaEnabled                Boolean                          @default(false)
  failedLoginAttempts       Int                              @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  memberships               Membership[]
  refreshSessions           RefreshSession[]
  createdLessons            Lesson[]                         @relation("LessonCreator")
  createdScheduleBlocks     ScheduleBlock[]                  @relation("ScheduleBlockCreator")
  createdTheoreticalClasses TheoreticalClass[]               @relation("TheoreticalClassCreator")
  createdLicenseProcesses   StudentLicenseProcess[]          @relation("LicenseProcessCreator")
  reviewedProcessDocuments  ProcessDocumentRequirement[]     @relation("ProcessDocumentReviewer")
  createdExams              Exam[]                           @relation("ExamCreator")
  auditLogs                 AuditLog[]                       @relation("AuditActor")
  createdContracts          StudentContract[]                @relation("ContractCreator")
  createdAdjustments        ContractAdjustment[]             @relation("AdjustmentCreator")
  receivedPayments          Payment[]                        @relation("PaymentReceiver")
  createdRefunds            PaymentRefund[]                  @relation("RefundCreator")
  openedCashRegisters       CashRegister[]                   @relation("CashRegisterOpener")
  closedCashRegisters       CashRegister[]                   @relation("CashRegisterCloser")
  createdCashMovements      CashMovement[]                   @relation("CashMovementCreator")
  createdExpenses           Expense[]                        @relation("ExpenseCreator")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  communicationSettings     UserCommunicationSettings?
  notificationDeliveries    NotificationDelivery[]
  devicePushTokens          DevicePushToken[]
  createdCampaigns          CommunicationCampaign[]          @relation("CampaignCreator")
  campaignRecipients        CommunicationCampaignRecipient[]
  lessonChangeRequests      LessonChangeRequest[]            @relation("LessonChangeRequester")
  lessonEvaluations         LessonEvaluation[]               @relation("LessonEvaluator")
  vehicleOccurrences        VehicleOccurrence[]              @relation("VehicleOccurrenceReporter")
  mobileOperations          MobileOperation[]
  documentUploadSessions    DocumentUploadSession[]
  studentProfiles           Student[]                        @relation("StudentUser")
  instructorProfiles        Instructor[]                     @relation("InstructorUser")
  createdPlatformTenants    Tenant[]                         @relation("TenantCreatedByPlatformUser")
  supportSessions           SupportSession[]                 @relation("SupportPlatformUser")
  endedSupportSessions      SupportSession[]                 @relation("SupportEndedByUser")
  platformAuditLogs         AuditLog[]                       @relation("PlatformAuditActor")
  credentialTokens          UserCredentialToken[]
  createdImportJobs         ImportJob[]                      @relation("ImportJobCreator")
  passwordSetAt             DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  @@index([platformRole, active])
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  userId          String           @db.Uuid
  role            MembershipRole
  active          Boolean          @default(true)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshSessions RefreshSession[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  tenantId     String?         @db.Uuid
  membershipId String?         @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @unique @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("RefreshSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("RefreshSessionRotation")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, revokedAt])
  @@index([tenantId, membershipId])
  @@index([expiresAt])
}

model UserCredentialToken {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  tenantId   String?                 @db.Uuid
  type       UserCredentialTokenType
  tokenHash  String                  @unique
  expiresAt  DateTime
  consumedAt DateTime?
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())

  @@index([userId, type, consumedAt, expiresAt])
  @@index([tenantId, type, createdAt])
}

model Student {
  id                     String                           @id @default(uuid()) @db.Uuid
  tenantId               String                           @db.Uuid
  userId                 String?                          @db.Uuid
  name                   String
  socialName             String?
  cpf                    String
  birthDate              DateTime?
  email                  String?
  phone                  String?
  secondaryPhone         String?
  status                 RegistryStatus                   @default(ACTIVE)
  tenant                 Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?                            @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  address                StudentAddress?
  documents              StudentDocument[]
  notes                  StudentNote[]
  processes              StudentProcess[]
  licenseProcesses       StudentLicenseProcess[]
  processDocuments       ProcessDocumentRequirement[]
  exams                  Exam[]
  lessons                Lesson[]
  theoreticalClasses     TheoreticalClassStudent[]
  contracts              StudentContract[]
  receivables            ReceivableInstallment[]
  payments               Payment[]
  lessonChangeRequests   LessonChangeRequest[]
  lessonEvaluations      LessonEvaluation[]
  documentUploadSessions DocumentUploadSession[]
  campaignRecipients     CommunicationCampaignRecipient[]
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@unique([tenantId, cpf])
  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model StudentAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  studentId    String   @db.Uuid
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, tenantId])
  @@index([tenantId, studentId])
}

model StudentDocument {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @db.Uuid
  studentId                   String                       @db.Uuid
  type                        StudentDocumentType
  number                      String
  issuingAuthority            String?
  issuedAt                    DateTime?
  expiresAt                   DateTime?
  fileName                    String?
  fileMimeType                String?
  fileSizeBytes               Int?
  storageKey                  String?
  uploadedAt                  DateTime?
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                     Student                      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  processDocumentRequirements ProcessDocumentRequirement[]
  uploadSessions              DocumentUploadSession[]

  @@unique([tenantId, studentId, type, number])
  @@unique([id, tenantId])
  @@index([tenantId, studentId])
}

model StudentNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  content   String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId, createdAt])
}

model StudentProcess {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  studentId   String               @db.Uuid
  category    String
  renach      String?
  status      StudentProcessStatus @default(OPEN)
  openedAt    DateTime             @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student              @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId, studentId, status])
  @@index([tenantId, renach])
}

model Instructor {
  id                 String                           @id @default(uuid()) @db.Uuid
  tenantId           String                           @db.Uuid
  userId             String?                          @db.Uuid
  name               String
  cpf                String
  email              String?
  phone              String?
  license            String?
  licenseCategory    String?
  licenseExpiresAt   DateTime?
  credentialNumber   String?
  status             RegistryStatus                   @default(ACTIVE)
  tenant             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?                            @relation("InstructorUser", fields: [userId], references: [id], onDelete: SetNull)
  lessons            Lesson[]
  availabilities     InstructorAvailability[]
  scheduleBlocks     ScheduleBlock[]
  theoreticalClasses TheoreticalClass[]
  lessonEvaluations  LessonEvaluation[]
  vehicleOccurrences VehicleOccurrence[]
  campaignRecipients CommunicationCampaignRecipient[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([tenantId, cpf])
  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Vehicle {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  plate          String
  brand          String?
  model          String
  year           Int?
  color          String?
  renavam        String?
  chassis        String?
  category       String?
  status         RegistryStatus      @default(ACTIVE)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  scheduleBlocks ScheduleBlock[]
  occurrences    VehicleOccurrence[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, plate])
  @@unique([id, tenantId])
  @@unique([tenantId, renavam])
  @@index([tenantId, status])
  @@index([tenantId, model])
}

model Lesson {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @db.Uuid
  unitId             String                 @db.Uuid
  studentId          String                 @db.Uuid
  instructorId       String                 @db.Uuid
  vehicleId          String                 @db.Uuid
  type               LessonType             @default(PRACTICAL)
  status             LessonStatus           @default(PENDING)
  startsAt           DateTime
  endsAt             DateTime
  notes              String?
  cancellationReason String?
  createdByUserId    String                 @db.Uuid
  completedAt        DateTime?
  rescheduledFromId  String?                @unique @db.Uuid
  processId          String?                @db.Uuid
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               SchoolUnit             @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  student            Student                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  instructor         Instructor             @relation(fields: [instructorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  vehicle            Vehicle                @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy          User                   @relation("LessonCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rescheduledFrom    Lesson?                @relation("LessonReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo      Lesson?                @relation("LessonReschedule")
  process            StudentLicenseProcess? @relation(fields: [processId, tenantId], references: [id, tenantId], onDelete: Restrict)
  studentNotes       String?
  startOdometerKm    Int?
  endOdometerKm      Int?
  changeRequests     LessonChangeRequest[]
  evaluation         LessonEvaluation?
  vehicleOccurrences VehicleOccurrence[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
  @@index([tenantId, unitId, startsAt])
  @@index([tenantId, studentId, startsAt])
  @@index([tenantId, instructorId, startsAt])
  @@index([tenantId, vehicleId, startsAt])
  @@index([tenantId, processId, startsAt])
}

model SchoolUnit {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @db.Uuid
  name               String
  document           String?
  phone              String
  email              String
  address            String
  openingTime        String
  closingTime        String
