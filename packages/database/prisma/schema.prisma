  uploadedAt           DateTime?
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  student              Student                     @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  document             StudentDocument?            @relation(fields: [documentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  processRequirement   ProcessDocumentRequirement? @relation(fields: [processRequirementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, studentId, status, expiresAt])
}
